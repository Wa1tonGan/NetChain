# NetChain Docker demo stack — copy to .env and fill in:
#   cp .env.docker.example .env
# Everything here is read by docker compose (backend env_file + build-arg
# interpolation). The zkLogin / Google OAuth variables are intentionally NOT
# part of the docker stack — the demo signs with the agent escrow pool or a
# Slush wallet.

# --- The box's public address (baked into the frontend at BUILD time) --------
# EC2 public IP or DNS name. If it changes later:
#   docker compose build frontend && docker compose up -d frontend
PUBLIC_IP=

# --- Sui network -------------------------------------------------------------
# Testnet ONLY — never point anything at mainnet.
SUI_NETWORK=testnet

# Platform operator key (AuthorityCap holder) — signs every commit/settle from
# the pre-funded escrow pool. Copy the value from your local dev .env: it must
# be the SAME key that owns the testnet escrow referenced by
# .sui/config.testnet.json (copy that file to the box too — see DEPLOY_EC2.md).
# NEVER commit this value anywhere.
PLATFORM_SECRET=

# --- Agent market / Truth Agent (Gonka inference) ----------------------------
# Without a key everything still runs: ranking falls back to deterministic
# (no Round-1 vote cards) and the Truth-Agent audit reports TIMEOUT (the
# Round-2 card shows that honestly). With a key you get the full multi-LLM
# consensus + SLA audit cards.
GONKA_API_KEY=
GONKA_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,moonshotai/Kimi-K2.6,MiniMaxAI/MiniMax-M2.7
TRUTH_AGENT_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,MiniMaxAI/MiniMax-M2.7

# --- Optional knobs ----------------------------------------------------------
# Pin the provider market roll for rehearsals (unset = fresh market per launch)
PROVIDER_SEED=
# Trust ledger callback target is overridden by docker-compose.yml — leave unset here.
# WALRUS_EPOCHS=30
