# NetChain — configuration reference (Person 1 + 2 + 3).
# Copy to `.env` (gitignored):  cp .env.example .env
# Every script reads these via `node --env-file-if-exists=.env`.
# Rule: testnet / localnet ONLY — never point anything at mainnet.
#
# ============ COMPULSORY (the demo does not work without these) ============

# --- Network -----------------------------------------------------------------
# testnet is remote — no local node needed. localnet needs
# `sui start --with-faucet --force-regenesis` running first.
SUI_NETWORK=testnet

# --- Platform operator keys (REAL VALUES STAY IN .env — gitignored) ----------
# The platform wallet owns the escrow pool + AuthorityCap and signs
# settle/refund/verify. SUI_BUYER_SECRET is the setup/operator alias:
# scripts/sui-setup.mjs resolves its operator via buyerKeypair()
# (SUI_BUYER_SECRET -> PLATFORM_SECRET -> PEM fallback) — point BOTH at the
# same platform key so the platform owns everything.
SUI_BUYER_SECRET=
PLATFORM_SECRET=

# Platform fee wallet: receives the fee slice at settle (charged ON TOP of
# the provider's full quoted price). No key needed here — it only receives.
PLATFORM_ADDRESS=0xabc67fa394146947b426d6b9ed95cac2bddf4fa0b33593667c3603941002c8f4
# Fee percent on the plan price. 5 = "plan 1.875 + fee 0.09 → escrow 1.965 →
# 1.875 provider + 0.09 platform".
PLATFORM_FEE_PERCENT=5

# --- Service ports + wiring ----------------------------------------------------
TRUST_PORT=8200
GATEWAY_PORT=8082
ZKL_PORT=8787
CLAIM_PORT=8105
# Trust server -> Rescue Agent gateway base URL (callbacks + integration).
SUI_P2_URL=http://127.0.0.1:8082
# Settlement status (SETTLED/REFUNDED/RECLAIMED) POSTed back to the gateway.
P2_CALLBACK_URL=http://127.0.0.1:8082/callbacks/settlement

# --- zkLogin bridge (Google sign-in + zk proof proxy) --------------------------
ZKL_ALLOWED_ORIGIN=http://localhost:5173
# true (default) = browser zk-signing (non-custodial). false = server-side
# custodial fallback, clearly labeled in the UI — demo continuity only.
ZK_SIGNING=true
# Sui zk prover (groth16), proxied by the bridge at POST /api/zklogin/prove.
# prover-dev-v2.mystenlabs.com = the TESTNET v2-circuit prover (testnet now
# verifies v2 proofs; v1 proofs from prover-dev fail on-chain with
# "Groth16 proof verify failed"). prover.mystenlabs.com = mainnet, which only
# accepts allowlisted client IDs (Enoki Portal registration).
ZK_PROVER_URL=https://prover-dev-v2.mystenlabs.com/v1
# Google OAuth web client. Redirect URI must match this exact value and be
# registered in Google Cloud Console: http://localhost:5173/zklogin
GOOGLE_CLIENT_ID=422185875355-h4qgtepsjugs6539vgkuednlr1rbuh19.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:5173/zklogin

# --- Gonka router (OpenAI-compatible multi-model inference) --------------------
# Without GONKA_API_KEY ranking/verification fall back to deterministic
# scoring (the demo runs, but no LLM votes are shown).
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_API_KEY=
GONKA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Multi-model consensus (comma-separated). All fire in parallel; only answers
# within GONKA_RANKING_BUDGET_MS vote — slow models are discarded by the clock.
GONKA_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,moonshotai/Kimi-K2.6,MiniMaxAI/MiniMax-M2.7
GONKA_RANKING_BUDGET_MS=8000
# Truth Agent live-data pass + per-claim budget (all models must answer in-window).
GONKA_VERIFY_WEB=true
GONKA_VERIFY_BUDGET_MS=25000

# ============ OPTIONAL (safe defaults; tune only if needed) ============

# Sui CLI binary used by sui:setup (empty = auto %USERPROFILE%/sui-cli/sui.exe
# on Windows, `sui` on PATH elsewhere).
SUI_BIN=
# Localnet gRPC endpoint (SDK v2 uses gRPC; public fullnodes dropped JSON-RPC).
SUI_LOCALNET_URL=http://127.0.0.1:9000
# Minimum gas balance check before setup (MIST); setup auto-faucets below it.
SUI_MIN_GAS_MIST=

# Voucher freshness window baked into fixtures/sui/ at generation (5 min).
SUI_FIXTURE_TTL_MS=300000
# Optional: pin the fixture clock (ms epoch) for deterministic replays/tests.
SUI_FIXTURE_EPOCH_MS=

# --- P2 runtime integration (blueprint §8 M3, live AI↔Sui loop) ----------------
# standalone (default): scripted demo only, no gateway dependency.
# one-loop:  `npm run integrate:sui` drives ONE incident end-to-end.
# full:      trust:server polls the gateway and commits/verifies/settles EVERY
#            resolved incident automatically.
SUI_INTEGRATION_MODE=standalone
SUI_P2_POLL_MS=3000
# Optional one-loop overrides: submit this scenario, or pull an already-
# resolved incident by id for replay demos.
SUI_P2_INTENT=
SUI_P2_INCIDENT_ID=

# --- zkLogin extras -------------------------------------------------------------
# Deterministic master seed for deriving per-user salts (32+ byte hex).
# Do NOT change after real users log in. Leave ABSENT to use the built-in demo
# seed — setting it to an EMPTY string changes salt derivation (env trap).
#ZKL_SALT_MASTER_SEED=
# Optional separate secret for signing OAuth state (defaults to salt seed).
ZKL_STATE_SECRET=
# Ephemeral key epoch window (how many epochs the session key stays valid).
VITE_ZK_MAX_EPOCH=10

# --- Agent market ----------------------------------------------------------------
# Pin the dynamic-provider roll for rehearsals (unset = fresh market per launch,
# random brands + characteristics, stable ids/keys).
PROVIDER_SEED=
# Person 3 commitment ack (empty = proceed in parallel immediately).
PERSON3_ACK_URL=
# Tolerated delivery shortfall (percent) before a proportional penalty hits the
# provider payout at settle.
DELIVERY_TOLERANCE_PERCENT=10

# --- Walrus evidence archive (optional) --------------------------------------
# true → after each integrated settlement, voucher + connection log + split are
# archived to Walrus testnet (blob ID → ARCHIVED ledger event). OFF by default.
WALRUS_ARCHIVE=
WALRUS_EPOCHS=1

# --- Stablecoin asset (defaults live in src/sui/stablecoin.js) ------------------
# Testnet = Circle USDC 6dp; localnet = MYRC demo coin 2dp. Override only if
# you know why.
STABLECOIN_TYPE=
STABLECOIN_DECIMALS=
STABLECOIN_CURRENCY=
# Human USDC funded into each fresh escrow pool on testnet.
STABLECOIN_ESCROW_FUND=12
# Quote-time price scale. Profiles are natively USDC-scale (S2 ≈ 1.9 USDC), so
# the default is 1 — no scale-down anywhere in the flow. Set < 1 only to fit a
# tiny pool. NEVER set to an empty string: Number("") = 0 collapses every
# quote to 0 (the scale hook is `?? 1`, so only absence gives the default).
#SUI_TESTNET_PRICE_SCALE=
