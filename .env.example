# NetChain — Sui trust layer configuration (Person 3)
# Copy to `.env` (gitignored):  cp .env.example .env
# Every script reads these via `node --env-file-if-exists=.env` — no secrets
# here: all demo signing keys live in fixtures/keys/ (public demo fixtures).
# Rule: testnet / localnet ONLY — never point anything at mainnet.

# --- Network -----------------------------------------------------------------
# localnet (default) needs `sui start --with-faucet --force-regenesis` running.
# testnet is remote — no local node needed.
SUI_NETWORK=localnet

# Localnet gRPC endpoint (SDK v2 uses gRPC; public fullnodes removed JSON-RPC).
SUI_LOCALNET_URL=http://127.0.0.1:9000

# Sui CLI binary used by sui:setup for `move build` (Windows default shown).
SUI_BIN=

# Optional: minimum gas balance check before setup (MIST). Lower it when the
# faucet granted exactly 1 SUI — the whole testnet proof costs < 0.5 SUI.
SUI_MIN_GAS_MIST=

# --- Fixtures ----------------------------------------------------------------
# Voucher freshness window baked into fixtures/sui/ at generation (5 min).
# Fixtures expire ON-CHAIN (expiry is inside the buyer-signed payload), so
# demo/harness regenerate them at run start; keep this ≥ a run's length.
SUI_FIXTURE_TTL_MS=300000

# Optional: pin the fixture clock (ms epoch) for deterministic replays/tests.
SUI_FIXTURE_EPOCH_MS=

# --- Trust service -----------------------------------------------------------
# HTTP+SSE trust service port (Person 2 reserved 8101–8103 for their agents).
TRUST_PORT=8200

# Optional: POST settlement status (SETTLED/REFUNDED/RECLAIMED) to Person 2's
# endpoint — e.g. http://127.0.0.1:8101/incidents/callback
P2_CALLBACK_URL=

# --- Agent market (Person 2) ---------------------------------------------------
# GonkaRouter (OpenAI-compatible inference endpoint)
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_API_KEY=
GONKA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Multi-model consensus (comma-separated). Only answers within
# GONKA_RANKING_BUDGET_MS vote; slow models are discarded by the clock.
GONKA_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,moonshotai/Kimi-K2.6,MiniMaxAI/MiniMax-M2.7
GONKA_RANKING_BUDGET_MS=8000

# Person 3 commitment ack (optional; empty = proceed in parallel immediately)
PERSON3_ACK_URL=

# Gateway port (provider agents sit on 8101–8103)
GATEWAY_PORT=8082

# --- Platform fee split (blueprint §1.3 / §3.3 / §12) -------------------------
# The settlement splits the escrow: provider receives its FULL quoted plan
# price, this address receives the fee (charged ON TOP, shown openly).
# Leave PLATFORM_ADDRESS empty to disable the split (fee 0, single payout).
PLATFORM_ADDRESS=0xabc67fa394146947b426d6b9ed95cac2bddf4fa0b33593667c3603941002c8f4

# Fee percent on the plan price (never on the wallet balance). 5 = demo's
# "plan 300 + fee 15 → escrow locks 315 → 300 provider + 15 platform".
PLATFORM_FEE_PERCENT=5

# Verification Agent (blueprint §4.3): tolerated delivery shortfall in percent
# before a proportional penalty is deducted from the provider payout.
DELIVERY_TOLERANCE_PERCENT=10

# --- Stablecoin asset (Sui Track 01 — Payments & Stablecoins) -----------------
# Testnet escrows hold Circle's NATIVE USDC (on Sui's gasless-transfer
# allowlist, 6 decimals); localnet keeps the MYRC demo coin (0 decimals).
# Defaults live in src/sui/stablecoin.js — override only if needed.
STABLECOIN_TYPE=
STABLECOIN_DECIMALS=
STABLECOIN_CURRENCY=
# Human USDC funded into each demo/harness escrow pool on testnet (faucet
# drips are small — 12 is sized for a full proof round).
STABLECOIN_ESCROW_FUND=
# Fixture price scale on testnet (0.05 → S2 ≈ 3 USDC). Localnet: always 1.
SUI_TESTNET_PRICE_SCALE=
