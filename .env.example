# NetChain — Sui trust layer configuration (Person 3)
# Copy to `.env` (gitignored):  cp .env.example .env
# Every script reads these via `node --env-file-if-exists=.env` — no secrets
# here: all demo signing keys live in fixtures/keys/ (public demo fixtures).
# Rule: testnet / localnet ONLY — never point anything at mainnet.

# --- Network -----------------------------------------------------------------
# localnet (default) needs `sui start --with-faucet --force-regenesis` running.
# testnet is remote — no local node needed.
SUI_NETWORK=testnet

# Localnet gRPC endpoint (SDK v2 uses gRPC; public fullnodes removed JSON-RPC).
SUI_LOCALNET_URL=http://127.0.0.1:9000

# Sui CLI binary used by sui:setup for `move build` (Windows default shown).
SUI_BIN=

# Optional: minimum gas balance check before setup (MIST). Lower it when the
# faucet granted exactly 1 SUI — the whole testnet proof costs < 0.5 SUI.
SUI_MIN_GAS_MIST=

# --- Fixtures ----------------------------------------------------------------
# Voucher freshness window baked into fixtures/sui/ at generation (5 min).
# Fixtures expire ON-CHAIN (expiry is inside the buyer-signed payload), so
# demo/harness regenerate them at run start; keep this ≥ a run's length.
SUI_FIXTURE_TTL_MS=300000

# Optional: pin the fixture clock (ms epoch) for deterministic replays/tests.
SUI_FIXTURE_EPOCH_MS=

# --- Trust service -----------------------------------------------------------
# HTTP+SSE trust service port (Person 2 reserved 8101–8103 for their agents).
TRUST_PORT=8200

# Optional: POST settlement status (SETTLED/REFUNDED/RECLAIMED) to Person 2's
# endpoint — the Rescue Agent's settlement callback:
#   http://127.0.0.1:8082/callbacks/settlement
P2_CALLBACK_URL=

# --- P2 runtime integration (blueprint §8 M3, live AI↔Sui loop) --------------
# standalone (default): scripted demo only, no gateway dependency.
# one-loop:  `npm run integrate:sui` drives ONE incident end-to-end through
#            the live Rescue Agent (deadline-safe fallback of full mode).
# full:      `npm run trust:server` polls the gateway and commits/verifies/
#            settles EVERY resolved incident automatically.
SUI_INTEGRATION_MODE=standalone
# Rescue Agent gateway (start with: node scripts/start-rescue-agent.mjs)
SUI_P2_URL=http://127.0.0.1:8082
# full-mode poll interval (ms)
SUI_P2_POLL_MS=3000
# Optional overrides for the one-loop driver:
#   submit this scenario instead of the default s2
SUI_P2_INTENT=
#   ...or pull an already-resolved incident by id instead of submitting
SUI_P2_INCIDENT_ID=

# --- zkLogin (Model A: Google login + derived address; Sui signing remains
# server-side in the trust layer) --------------------------------------------
# Port for the zkLogin bridge server: npm run zklogin:server
ZKL_PORT=8787
ZKL_ALLOWED_ORIGIN=http://localhost:5173

# Google OAuth web client. Redirect URI must match this exact value and be
# registered in Google Cloud Console:
#   http://localhost:5173/zklogin
GOOGLE_CLIENT_ID=422185875355-h4qgtepsjugs6539vgkuednlr1rbuh19.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:5173/zklogin

# Deterministic master seed for deriving per-user salts.
# Use a 32+ byte random hex value. Do NOT change after real users log in.
ZKL_SALT_MASTER_SEED=

# Optional separate secret for signing OAuth state. Defaults to
# ZKL_SALT_MASTER_SEED when unset.
ZKL_STATE_SECRET=

# --- Agent market (Person 2) ---------------------------------------------------
# GonkaRouter (OpenAI-compatible inference endpoint)
GONKA_BASE_URL=https://api.gonkarouter.io/v1
GONKA_API_KEY=
GONKA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# Multi-model consensus (comma-separated). Only answers within
# GONKA_RANKING_BUDGET_MS vote; slow models are discarded by the clock.
GONKA_MODELS=deepseek-ai/DeepSeek-V4-Flash-0731,MiniMaxAI/MiniMax-M2.7
GONKA_RANKING_BUDGET_MS=8000

# Truth Agent (claim verification, npm run claim:server / src/a2a/claimAgent.js)
CLAIM_PORT=8105
# Live-data pass: fetch the claim's URL + DuckDuckGo snippets into the prompt
GONKA_VERIFY_WEB=true
# Verification budget per claim (all models must answer inside the window)
GONKA_VERIFY_BUDGET_MS=25000

# TruthLink (Sui trust server → Truth Agent SLA audit, src/sui/truthLink.js)
TRUTH_AGENT_URL=http://127.0.0.1:8105
# Total audit budget incl. polling — the audit NEVER blocks settlement.
# MUST exceed GONKA_VERIFY_BUDGET_MS (the agent's own inference window)
# or the poller gives up before the models finish.
TRUTH_LINK_BUDGET_MS=90000

# Dynamic provider market: pin the roll for rehearsals (unset = new market
# every `npm start`-style launch: random brands + characteristics, stable ids/keys)
PROVIDER_SEED=

# Person 3 commitment ack (optional; empty = proceed in parallel immediately)
PERSON3_ACK_URL=

# Gateway port (provider agents sit on 8101–8103)
GATEWAY_PORT=8082

# --- zkLogin buyer-direct payments (Phase 7) ---------------------------------
# ZK_SIGNING=false → bridge derives per-session server keys (custodial
# fallback, labeled in the UI). Default/unset = true (browser zk-signing).
ZK_SIGNING=true
# Sui zk prover (groth16) proxied by the bridge at POST /api/zklogin/prove
ZK_PROVER_URL=https://prover-dev.mystenlabs.com/v1
# Ephemeral key validity: how many epochs AHEAD of the current chain epoch the
# zk session key stays valid (absolute maxEpoch = current + this). 10 ≈ 1-2 days.
VITE_ZK_MAX_EPOCH=10

# Platform operator key (AuthorityCap holder: settle/refund/verify + user
# cold-start funding). Gitignored — NEVER commit. Buyer keys are retired from
# the product path: commitments are zk-signed by the user (commit_as_buyer).
PLATFORM_SECRET=

# --- Platform fee split (blueprint §1.3 / §3.3 / §12) -------------------------
# The settlement splits the escrow: provider receives its FULL quoted plan
# price, this address receives the fee (charged ON TOP, shown openly).
# Leave PLATFORM_ADDRESS empty to disable the split (fee 0, single payout).
PLATFORM_ADDRESS=0xabc67fa394146947b426d6b9ed95cac2bddf4fa0b33593667c3603941002c8f4

# Fee percent on the plan price (never on the wallet balance). 5 = demo's
# "plan 300 + fee 15 → escrow locks 315 → 300 provider + 15 platform".
PLATFORM_FEE_PERCENT=5

# Verification Agent (blueprint §4.3): tolerated delivery shortfall in percent
# before a proportional penalty is deducted from the provider payout.
DELIVERY_TOLERANCE_PERCENT=10

# --- Walrus evidence archive (blueprint §4.3, optional) ----------------------
# true → after each integrated settlement, the voucher + connection log +
# settlement split are archived to Walrus testnet (blob ID → ARCHIVED ledger
# event). Independently retrievable evidence for user/provider/judge.
# OFF by default; testnet only — never mainnet.
WALRUS_ARCHIVE=
WALRUS_EPOCHS=1

# --- Stablecoin asset (Sui Track 01 — Payments & Stablecoins) -----------------
# Testnet escrows hold Circle's NATIVE USDC (on Sui's gasless-transfer
# allowlist, 6 decimals); localnet keeps the MYRC demo coin (0 decimals).
# Defaults live in src/sui/stablecoin.js — override only if needed.
STABLECOIN_TYPE=
STABLECOIN_DECIMALS=
STABLECOIN_CURRENCY=
# Human USDC funded into each demo/harness escrow pool on testnet (faucet
# drips are small — 12 is sized for a full proof round).
STABLECOIN_ESCROW_FUND=
# Quote-time price scale (both the live market and the fixture generator).
# Profiles are natively USDC-scale (S2 ≈ 1.9 USDC), so the default is 1 —
# no scale-down anywhere in the flow. Set < 1 only to fit a tiny escrow pool.
SUI_TESTNET_PRICE_SCALE=
