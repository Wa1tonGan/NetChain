# Docker build context (repo root) — used by BOTH the backend image and the
# frontend image (frontend/Dockerfile). Keep it lean and secret-free.
**/node_modules
frontend/dist
.git
.zcode
.playwright-mcp

# secrets & local state (injected at runtime via env_file / bind mounts)
.env
.env.*
.sui
events
*.log

# generated locally, never needed at runtime (keeps builds reproducible)
fixtures/sui
fixtures/providers/dynamic.json
move/build
*.png
